# Supabase Public Configuration (frontend access)
# Obtain these from your Supabase Dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Supabase Server-Only Service Role Key (Optional, for backend admin updates with strict RLS)
# Never expose this key to client bundles!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-Only Moderator Passcode (Required in production, never exposed to client bundle)
MODERATOR_SECRET_KEY=your_secure_moderator_passcode_here